# Local_AI/CHAVES.env — segredos do Estúdio (estudio_shopee) e do bootstrap
# do LiteLLM local (llm.py). Copie este arquivo para CHAVES.env (sem
# ".example") na mesma pasta e preencha com valores reais. CHAVES.env nunca
# é versionado (.gitignore); só este .example fica no controle de versão.

# fal.ai — remoção de fundo / edição de imagem via IA (app.py do Estúdio)
FAL_KEY=sua_chave_fal_ai

# Groq — chat rápido via LiteLLM local (llm.py), usado hoje para escrever a
# instrução de edição da imagem (texto apenas, não vê a foto)
GROQ=sua_chave_groq

# RunPod — GPU remota para os modelos "pesados" do LiteLLM local (llm.py)
RUNPOD_KEY=sua_chave_runpod
ENDPOINT_ID_RUNPOD_vLLM=seu_endpoint_id_de_imagens
ENDPOINT_ID_RUNPOD_DADOS=seu_endpoint_id_de_dados

# OpenAI — cliente REST direto (sem SDK) usado por gerador_anuncio.py para
# gerar o anúncio completo (título + descrição + palavras-chave) OLHANDO
# para a imagem final do produto (modelo com visão obrigatório)
OPENAI_API_KEY=sua_chave_openai
OPENAI_MODEL_ANUNCIO=gpt-5.6-luna
# Opcional: deixe vazio para usar https://api.openai.com/v1
OPENAI_API_BASE_URL=
