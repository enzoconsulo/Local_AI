POSTGRES_USER=admin_shopee
POSTGRES_PASSWORD=sua_senha_blindada
POSTGRES_DB=estudio_shopee
DB_HOST=localhost
DB_PORT=5433
TZ=America/Sao_Paulo

PGADMIN_DEFAULT_EMAIL=admin@estudio.com
PGADMIN_DEFAULT_PASSWORD=admin

SHOPEE_PARTNER_ID=seu_partner_id
SHOPEE_PARTNER_KEY=sua_partner_key
# SHOP_ID e REFRESH_TOKEN são gravados sozinhos por: python pegar_token.py
SHOPEE_SHOP_ID=seu_shop_id
SHOPEE_REFRESH_TOKEN=seu_token_de_acesso

# IP de saída fixo (recomendado): túnel SSH até a VM Oracle, o único IP na
# whitelist da Shopee. Vazio = chamadas saem direto pelo IP da sua internet.
TUNEL_SSH_HOST=
TUNEL_SSH_USUARIO=ubuntu
TUNEL_SSH_CHAVE=~/.ssh/id_shopee_tunnel
TUNEL_PORTA_LOCAL=1080

# Dono do token (recomendado se o BTT Pi roda o auto-boost): biqu@<ip-do-pi>.
# Este app pega o access_token emprestado do Pi por SSH e nunca renova sozinho.
# Vazio = este app tem autorização própria (pegar_token.py + tarefa diária).
TOKEN_VIA_PI=

GROQ_API_KEY=sua_chave_groq

# Cérebro IA — OpenAI API direta (substitui RunPod/LiteLLM)
OPENAI_API_KEY=sua_chave_openai
OPENAI_MODEL_7D=gpt-5.6-luna
OPENAI_MODEL_30D=gpt-5.6-terra
OPENAI_REASONING_7D=low
OPENAI_REASONING_30D=medium
# Opcional: deixe vazio para usar https://api.openai.com/v1
OPENAI_API_BASE_URL=
